tests {
  test("status is 200 or 204", function() {
    expect([200, 204]).to.include(res.status);
  });
  test("when 200 response is CSV string", function() {
    if (res.status === 200) {
      expect(res.getBody()).to.be.a('string');
    }
  });
}

