  body: json
  auth: none
}

body:json {
  {
    "email": "financeuser@example.com",
    "password": "Password123!",
    "name": "finance User"
  }
}

headers {
  Content-Type: application/json
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}