meta {
  name: Get Categories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/categories
  body: none
  auth: none
}

params:query {
  ~isActive: true
}

tests {
  test("should return 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data).to.be.an('array');
  });
}
