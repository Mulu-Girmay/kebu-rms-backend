meta {
  name: Sort Menu Items by Favorites (Descending)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/menu-items?sortBy=favoriteCount&order=desc&limit=20
  auth: inherit
}

headers {
  Content-Type: application/json
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("items are sorted by favoriteCount descending", function() {
    if (res.body.data.length > 1) {
      for (let i = 0; i < res.body.data.length - 1; i++) {
        expect(res.body.data[i].favoriteCount).to.be.gte(res.body.data[i + 1].favoriteCount);
      }
    }
  });
}