meta {
  name: Get Service Status
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/orders/service/status
  body: none
  auth: inherit
}

tests {
  test("should get service status", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
    expect(res.getBody().data).to.have.property('isOrdersPaused');
  });
}
