meta {
  name: Change Password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/user/me/password
  body: json
  auth: inherit

}

body:json {
  {
    "currentPassword": "Password123!",
    "newPassword": "NewSecurePassword456!"
  }
}

headers {
  Content-Type: application/json
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("message says changed", function() {
    expect(res.body.message).to.contain("Password changed");
  });
}