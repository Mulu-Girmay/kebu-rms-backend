meta {
  name: Get User Credit Account
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/admin/credit-accounts/{{customerUserId}}
  auth: inherit
}

tests {
  test("status is 200 or 404", function() {
    expect([200, 404]).to.include(res.status);
  });
  test("if 200, userId matches", function() {
    if (res.status === 200) {
      expect(res.body.data.userId).to.equal(bru.getVar("customerUserId"));
    }
  });
}