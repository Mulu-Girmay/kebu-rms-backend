}

body:json {
  { "reason": "Customer under investigation" }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("status is frozen", function() {
    expect(res.body.data.status).to.equal("frozen");
  });
}   