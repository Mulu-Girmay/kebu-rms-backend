{
  "name": "kebu-rms-backend",
  "version": "1.0.0",
  "description": "Ensure you have the following installed on your machine:\r * **Node.js** (v18 or higher recommended)\r * **npm** or **yarn**\r * **MongoDB** (running locally or a remote connection string)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:api:auth": "cd src/bruno/auth && bru run --env development",
    "test:api:users": "cd src/bruno/users && bru run --env development",
    "test:api": "npm run test:api:auth",
    "test:api:health": "cd src/bruno/healthCheck && bru run --env development  --output reports/health-report.xml",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml,ts,js}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "eslint --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@git.addissoftware.com:summer-internship-2026/kebu-rms-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.2.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "bcrypt": "^6.0.0",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  }
}
